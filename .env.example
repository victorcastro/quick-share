# Copy to .env and fill in from Firebase console -> Project settings -> Your apps -> SDK setup.
# Not a secret store: Vite inlines every VITE_* value into the bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional GA4 measurement ID from Firebase console -> Project settings -> Integrations -> Google
# Analytics. Only read in production builds; leave empty to build without analytics.
VITE_FIREBASE_MEASUREMENT_ID=

# reCAPTCHA Enterprise site key from Google Cloud Console -> Security -> Fraud Defense, registered
# under Firebase console -> App Check -> Apps. The GitHub Pages domain and "localhost" are both
# allowed domains on the key, so local development needs no debug token.
VITE_RECAPTCHA_SITE_KEY=

# Optional fallback, development only: App Check debug token from Firebase console -> App Check
# -> Apps -> Manage debug tokens. Only read when the dev server is running.
VITE_APPCHECK_DEBUG_TOKEN=
