# Copy to .env and fill in from Firebase console -> Project settings -> Your apps -> SDK setup.
# Not a secret store: Vite inlines every VITE_* value into the bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# reCAPTCHA v3 site key from Firebase console -> App Check -> Apps -> register the web app.
# Add both the GitHub Pages domain and "localhost" as accepted domains on the reCAPTCHA site,
VITE_RECAPTCHA_SITE_KEY=
